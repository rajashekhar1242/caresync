# Copy to .env for local development and replace placeholders before running.
# Never commit .env with real secrets.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/caresync
SPRING_DATASOURCE_USERNAME=caresync
SPRING_DATASOURCE_PASSWORD=replace-with-local-db-password

# Base64 or >= 32-char random secret for HS256 JWT signing (required in prod)
CARESYNC_JWT_SECRET=replace-with-cryptographically-random-secret-at-least-32-bytes

# Comma-separated allowed CORS origins
CARESYNC_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial credentials for seeded ADMIN and RECEPTIONIST accounts (bootstrap on first start)
CARESYNC_ADMIN_EMAIL=admin@caresync.local
CARESYNC_ADMIN_PASSWORD=
CARESYNC_RECEPTIONIST_EMAIL=reception@caresync.local
CARESYNC_RECEPTIONIST_PASSWORD=

# Optional initial credentials for seeded demonstration DOCTOR and PATIENT accounts
CARESYNC_DEMO_DOCTOR_PASSWORD=
CARESYNC_DEMO_PATIENT_PASSWORD=
