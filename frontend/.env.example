# CareSync / HCMS Frontend Environment Configuration

# -------------------------------------------------------------
# Local Development (Default Vite dev server with /api proxy):
# -------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_API_TIMEOUT=60000
VITE_APP_NAME="CareSync Hospital & Clinic Management"

# -------------------------------------------------------------
# Portfolio Cloud Deployment (Cloudflare Pages -> Render Web Service):
# -------------------------------------------------------------
# VITE_API_BASE_URL=https://caresync-api.onrender.com/api
# VITE_WS_URL=wss://caresync-api.onrender.com/ws
# VITE_API_TIMEOUT=60000
# VITE_APP_NAME="CareSync Hospital & Clinic Management"
